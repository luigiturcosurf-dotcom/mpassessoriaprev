# MP Assessoria · Redirecionar Pensão por Morte (WordPress → Vercel)
# Cole no .htaccess da RAIZ do WordPress OU em cada pasta da LP no cPanel.
#
# Destino: quiz v2 + Lead/LeadDesqualificado
# Base: https://aposentadoria-rural.vercel.app

RewriteEngine On

# /pensaopormorte → LP preta (equivalente pensaopormorte1.1)
RewriteRule ^pensaopormorte/?$ https://aposentadoria-rural.vercel.app/pensaopormorte1.1/ [R=301,L,QSA]
RewriteRule ^pensaopormorte/(.*)$ https://aposentadoria-rural.vercel.app/pensaopormorte1.1/$1 [R=301,L,QSA]

RewriteRule ^pensaopormorte1\.1/?$ https://aposentadoria-rural.vercel.app/pensaopormorte1.1/ [R=301,L,QSA]
RewriteRule ^pensaopormorte1\.1/(.*)$ https://aposentadoria-rural.vercel.app/pensaopormorte1.1/$1 [R=301,L,QSA]

RewriteRule ^pensaopormorte2/?$ https://aposentadoria-rural.vercel.app/pensaopormorte2/ [R=301,L,QSA]
RewriteRule ^pensaopormorte2/(.*)$ https://aposentadoria-rural.vercel.app/pensaopormorte2/$1 [R=301,L,QSA]

RewriteRule ^pensaopormorte4/?$ https://aposentadoria-rural.vercel.app/pensaopormorte4/ [R=301,L,QSA]
RewriteRule ^pensaopormorte4/(.*)$ https://aposentadoria-rural.vercel.app/pensaopormorte4/$1 [R=301,L,QSA]
